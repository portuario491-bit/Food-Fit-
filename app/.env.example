# Copia este archivo a .env (o define estas variables en tu entorno) antes
# de desplegar el piloto. Sin ellas la app funciona igualmente, pero con
# valores por defecto pensados solo para desarrollo local.

# Clave para firmar las cookies de sesión. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Código que las personas invitadas deberán escribir al registrarse.
# Si lo dejas vacío, cualquiera con el enlace podrá crear una cuenta.
BLUEHEART_INVITE_CODE=

# Notificaciones por email cuando llega un mensaje de chat nuevo. Usa tu
# propia cuenta de Gmail (con una "contraseña de aplicación", no tu
# contraseña normal). Si las dejas vacías, la app funciona igual pero sin
# mandar esos avisos.
EMAIL_USER=
EMAIL_PASS=

# Notificaciones push del navegador (segundo canal de aviso, además del
# email). Son un par de claves criptográficas propias de esta app, no
# hace falta darse de alta en ningún sitio para generarlas —
# genéralas con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com

# Contraseña del panel de administración (/admin) — lista de personas
# registradas, matriz de compatibilidad completa y borrado de cuentas.
# Sin esta variable, /admin no deja entrar a nadie. Usa una contraseña
# distinta del código de invitación y no la compartas con el piloto.
ADMIN_PASSWORD=

# Puerto en el que arranca el servidor (opcional, por defecto 3000).
PORT=3000

# Rutas para la base de datos SQLite y las fotos subidas. Déjalas vacías en
# local (usan app/data y app/uploads por defecto). En producción, apúntalas
# a la ruta donde tu plataforma de hosting monte el volumen persistente —
# si no, los datos se borrarán en cada despliegue o reinicio.
DATA_DIR=
UPLOADS_DIR=
