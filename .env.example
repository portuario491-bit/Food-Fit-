# Proveedor de datos financieros: "mock" | "eodhd" | "fmp"
# Si no se define, o si faltan las API keys, la app usa datos mock claramente identificados.
FINANCIAL_DATA_PROVIDER=mock

# EODHD (https://eodhd.com) - proveedor principal recomendado (cobertura global)
EODHD_API_KEY=

# Financial Modeling Prep (https://financialmodelingprep.com) - proveedor secundario/backup
FMP_API_KEY=

# Supabase (persistencia de watchlists/portfolios de usuario en fases futuras)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
