# Proveedor de datos financieros: "ibex35" (por defecto) | "mock" | "eodhd" | "fmp"
# Por defecto usa el universo real del IBEX35 recopilado manualmente (Ibex35Provider).
# "mock" usa el universo ficticio de prueba. Si se pide eodhd/fmp sin tener la
# integración implementada, cae de nuevo en Ibex35Provider.
FINANCIAL_DATA_PROVIDER=ibex35

# EODHD (https://eodhd.com) - proveedor principal recomendado (cobertura global)
EODHD_API_KEY=

# Financial Modeling Prep (https://financialmodelingprep.com) - proveedor secundario/backup
FMP_API_KEY=

# Supabase (persistencia de watchlists/portfolios de usuario en fases futuras)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cotizaciones (precio actual): "dataset" (por defecto) | "alphavantage" | "finnhub" | "twelvedata" | "polygon" | "eodhd"
# Por defecto (sin configurar, o "dataset") no hay proveedor en vivo: PriceService
# usa el precio y la fecha ya presentes en los fundamentales como único dato
# disponible ("último cierre conocido"), igual que ahora. Los demás valores ya
# tienen su clase preparada en lib/prices/providers/, pero NINGUNO está
# implementado todavía (Fase 2) — si se configuran sin implementar, el sistema
# avisa por consola y sigue usando "dataset". Nunca se expone al navegador:
# solo se lee en Server Components / rutas de servidor.
PRICE_DATA_PROVIDER=dataset

ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
POLYGON_API_KEY=
# (para EODHD como proveedor de cotizaciones se reutilizaría EODHD_API_KEY, ya definida arriba)
